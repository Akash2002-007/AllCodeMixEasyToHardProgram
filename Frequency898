public class Frequency898 {

	public static void main(String[] args) {
		// TODO Auto-generated method stub
     String str= "JavaProgramming";
    int  count=0;
        
    char ch='a';
    
    for(int i=0;i<str.length();i++) {
    	
    	if(str.charAt(i)==ch) {
    		count++;
    		
    	}
    	
    }
    System.out.println(count+" "+ch);
    
	}

