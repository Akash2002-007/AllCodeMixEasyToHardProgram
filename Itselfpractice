package com.nit;

public class Itselfpractice {

	public static void main(String[] args) {
		// TODO Auto-generated method stub
             int num=90;
             
             for(int i=2;i<=num;i++) {
          boolean prime=true;
            	 for(int j=2;j<=i/2;j++) {
            		 if(i%j==0) {
            			 prime=false;
            			 break;
            		 }
            		 
            	 }
            	 if(prime) {
            		 System.out.println(i+"");
            	 }
            	 
             }
            
	}

}
