package src.com.nit;

public class AllCommon {

	public static void main(String[] args) {
		// TODO Auto-generated method stub
     int []a= {1,2,3,4,5,6,7,8,9};
     int b=a[2];
     
     for(int i=2;i<a.length-1;i++) {
    	 a[i]=a[i+1];
     }
     a[a.length-1]=b;
     for(int num:a) {
    	 System.out.println(num+" ");
     }
	}

}
