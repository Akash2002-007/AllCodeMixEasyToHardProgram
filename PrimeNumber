
public class PrimeNumber {

	public static void main(String[] args) {
		// TODO Auto-generated method stub
           int num=20;
           boolean prime=true;
           for(int i=2;i<=num;i++) {
        	     prime =true;
        	   for(int j=2;j<=i/2;j++) {
        		   if(i%j==0) {
        		   prime=false;
        		   break;
        	   }}
        	  
           }
           if(prime) {
    		   System.out.println("Prime Number");
    	   }else {
    		   System.out.println("It is not prime number");
    	   }
	}

}
